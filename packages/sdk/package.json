{
  "name": "@diwang/sdk",
  "version": "0.1.0",
  "description": "低侵入的浏览器性能与错误监控 SDK",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "acceptance:browser": "node browser-acceptance/server.mjs",
    "build": "tsup --config tsup.config.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@diwang/contracts": "workspace:*"
  }
}
