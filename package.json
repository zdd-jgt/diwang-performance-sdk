{
  "name": "diwang-performance-sdk-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.0",
  "engines": {
    "node": "22.x"
  },
  "volta": {
    "node": "22.23.1",
    "pnpm": "10.32.0"
  },
  "scripts": {
    "acceptance:browser": "pnpm --filter @diwang/sdk build && pnpm --filter @diwang/sdk acceptance:browser",
    "build": "pnpm -r --if-present build",
    "dev:dashboard": "pnpm --parallel --filter @diwang/query-api --filter @diwang/dashboard dev",
    "dev:dashboard:mock": "pnpm --filter @diwang/dashboard dev:mock",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  }
}
